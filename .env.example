# Copy this file to .env (which is git-ignored) and fill it in. Never commit .env.
# Leave KAMI_TELEGRAM_ENABLE=0 to keep alerts in dry run (nothing is sent). See docs/notifications.md.
# Bot token from @BotFather:
TELEGRAM_BOT_TOKEN=
# Filled in by: python scripts/telegram_find_chat.py
TELEGRAM_CHAT_ID=
KAMI_TELEGRAM_ENABLE=0

# Citizen interface on the same bot (Round 6, docs/citizen.md). Off unless KAMI_CITIZEN_ENABLE=1.
KAMI_CITIZEN_ENABLE=0
# Optional: other numeric chat ids that may use the bot, comma-separated (TELEGRAM_CHAT_ID is always allowed).
CITIZEN_ALLOWED_CHAT_IDS=
# Speech models: leave empty for the defaults chosen in Round 6. Device: cuda or cpu.
CITIZEN_ASR=
CITIZEN_TTS=
CITIZEN_DEVICE=cuda
# Local LLM served by Ollama on this machine (never a remote server, never a :cloud model).
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
