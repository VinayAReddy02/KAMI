# Copy this file to .env (which is git-ignored) and fill in your own Twilio WhatsApp sandbox details.
# Never commit .env. Leave KAMI_WHATSAPP_ENABLE=0 to keep alerts in dry run (nothing is sent).
# See docs/notifications.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
KAMI_WHATSAPP_ENABLE=0
# Lifetime budget: sending stops for good after this many messages (trial accounts include 100 free WhatsApp messages).
WHATSAPP_MAX_TOTAL=80
